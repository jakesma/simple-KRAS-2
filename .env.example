# Construction Firebase Configuration
# Use a separate Firebase project for this construction KRAS service.
# Get these values from Firebase Console: https://console.firebase.google.com
# Project Settings > General > Web App Configuration

# Firebase API Key
VITE_CONSTRUCTION_FIREBASE_API_KEY=your_firebase_api_key

# Firebase Auth Domain
VITE_CONSTRUCTION_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com

# Firebase Project ID
VITE_CONSTRUCTION_FIREBASE_PROJECT_ID=your_project_id

# Firebase Storage Bucket
VITE_CONSTRUCTION_FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Firebase Messaging Sender ID
VITE_CONSTRUCTION_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Firebase App ID
VITE_CONSTRUCTION_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id

# Local Development API URL
VITE_API_URL=http://localhost:3000

# PortOne (구 아임포트) KG이니시스 결제 연동 설정
# PortOne 관리자 콘솔(https://admin.portone.io) > 결제 연동에서 발급받은 키를 입력하세요.
VITE_PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
